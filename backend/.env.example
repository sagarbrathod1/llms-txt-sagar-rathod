# Copy to .env for local overrides. Every default below already matches docker-compose.yml and
# the Next.js dev server, so local development works without a .env file.
DATABASE_URL=postgresql://llms:llms@localhost:5432/llms

# Comma-separated browser origins allowed to call the API (the web app's URL).
CORS_ORIGINS=http://localhost:3000

# Optional regex for more allowed origins, e.g. a host's per-deployment preview URLs. Anchor it
# with ^...$. Empty means only CORS_ORIGINS. Production sets it in fly.toml.
CORS_ORIGIN_REGEX=

# Run the job worker inside the API process (the $0 scale-to-zero deployment). Leave false
# locally and run `uv run python -m app.worker.main` separately. See app/worker/main.py.
EMBEDDED_WORKER=false
