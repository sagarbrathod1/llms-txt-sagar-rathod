# Copy to .env for local overrides. The defaults below match docker-compose.yml and the
# Next.js dev server, so local development works without a .env file except for CORS.
DATABASE_URL=postgresql://llms:llms@localhost:5432/llms

# Comma-separated browser origins allowed to call the API (the web app's URL).
CORS_ORIGINS=http://localhost:3000

# Run the job worker inside the API process (the $0 scale-to-zero deployment). Leave false
# locally and run `uv run python -m app.worker.main` separately. See app/worker/main.py.
EMBEDDED_WORKER=false
